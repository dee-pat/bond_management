prefix_rule(
    pattern = ["bench", "db-console"],
    decision = "forbidden",
    justification = "Do not disclose site configuration or open a database console. See docs/verification.md.",
    match = ["bench db-console"],
    not_match = ["bench --site bond-management-example-00000000000000000000000000000000.localhost migrate"],
)

